# Copy this file to .env and fill in your keys.
# .env is git-ignored. Never commit real secrets.

# OpenRouter (used by aider and other OpenRouter-backed adapters)
OPENROUTER_API_KEY=

# OpenAI (if using an OpenAI-backed adapter)
# OPENAI_API_KEY=

# Anthropic (if using an Anthropic-backed adapter)
# ANTHROPIC_API_KEY=