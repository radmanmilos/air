{
    "name": "air",
    "version": "0.2.0",
    "description": "Unified AI tool orchestrator with smart routing and failover",
    "type": "module",
    "bin": {
        "air": "./dist/bin/air.js"
    },
    "main": "./dist/src/index.js",
    "exports": {
        ".": {
            "import": "./dist/src/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "files": [
        "dist",
        "config",
        "docs",
        "contracts",
        "packages/local-worker/air_local",
        "packages/local-worker/pyproject.toml",
        "packages/local-worker/config.yaml",
        "packages/local-worker/README.md",
        "!packages/local-worker/air_local/**/__pycache__",
        "!packages/local-worker/air_local/**/*.pyc"
    ],
    "scripts": {
    "build": "tsc",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:dist": "node scripts/check-dist-imports.mjs",
        "mutation:check": "node scripts/mutation-check.mjs",
        "e2e:det": "vitest run tests/e2e",
        "e2e:live": "vitest run --config vitest.live.config.ts",
        "postbuild": "node scripts/fix-imports.mjs",
        "prebuild": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
        "typecheck": "tsc --noEmit",
        "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsx bin/air.ts",
        "prepublishOnly": "npm run build && npm run test"
    },
    "keywords": [
        "ai",
        "orchestrator",
        "router",
        "cli",
        "mcp",
        "failover",
        "aider",
        "goose"
    ],
    "author": "radmanmilos",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/radmanmilos/air.git"
    },
    "bugs": {
        "url": "https://github.com/radmanmilos/air/issues"
    },
    "homepage": "https://github.com/radmanmilos/air",
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.32.2",
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "cross-spawn": "^7.0.5",
        "typescript": "^5.4.5",
        "yaml": "^2.4.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^20.12.7",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "knip": "^6.44.2",
        "tsx": "^4.7.2",
        "vitest": "^1.6.0"
    }
}
